# Frontend build-time config. This file (the .example) is what crates/frontend/build.rs
# reads and bakes into the wasm bundle — a local .env.frontend is NOT used by the build.
# Nothing here is secret (it all ships to the browser). A process env var of the same
# name overrides the value here (e.g. make frontend-build sets PLAP_API_BASE).

# API origin. Local `cargo lambda watch` by default; swap for the deployed API
# when building to ship:
#   PLAP_API_BASE=https://plap-api.ramadoka.com
PLAP_API_BASE=http://127.0.0.1:9001

# S3 bucket with the comfyui/ model tree (MODEL_BUCKET on the api lambda).
PLAP_MODEL_BUCKET=virginia-ramadoka

# S3 bucket for generated input/output artifacts (OUTPUT_BUCKET on the api lambda).
PLAP_IO_BUCKET=ap3.ramadoka.com
